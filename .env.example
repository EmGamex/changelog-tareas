# Token personal de la API de ClickUp (requerido)
CLICKUP_API_TOKEN=tu_token_de_clickup_aqui

# Nombre del autor para el pie de página del changelog (opcional)
# Si se deja vacío o no se define, se usará un mensaje genérico seguro.
AUTOR_NOMBRE=Juan

# Mapeo de IDs de listas de ClickUp a nombres de materias (opcional)
# Si se omite, el sistema autodescubrirá todas las listas en la primera ejecución y las guardará aquí automáticamente.
# CLICKUP_LISTAS_MATERIAS={"123456789012": "Matemáticas", "123456789013": "Filosofía"}
